{
  "name": "api-boilerplate",
  "version": "1.0.0",
  "description": "NestJS API Boilerplate",
  "author": "shuja Naqvi",
  "scripts": {
    "serve:dev": "ts-node-dev --files --inspect --respawn ./src/main.ts",
    "serve:prod": "NODE_ENV=production node dist/api/main.js",
    "build": "rimraf dist && tsc --project tsconfig.json --skipLibCheck",
    "build:prod": "NODE_ENV=production rimraf dist && tsc --project tsconfig.json --skipLibCheck",
    "lint": "eslint \"src/**/*.ts\" -c .eslintrc.json",
    "lint:fix": "eslint \"src/**/*.ts\" -c .eslintrc.json --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "e2e": "jest --detectOpenHandles --config ./e2e/jest-e2e.json",
    "typeorm": "ts-node ./node_modules/typeorm/cli.js",
    "typeorm-schema-sync": "ts-node ./node_modules/typeorm/cli.js migration:generate --check -n Test"
  },
  "pre-commit": ["lint", "test"],
  "private": true,
  "dependencies": {
    "@nestjs/axios": "^0.0.1",
    "@nestjs/common": "^8.0.6",
    "@nestjs/core": "^8.0.6",
    "@nestjs/jwt": "^8.0.0",
    "@nestjs/passport": "^8.0.1",
    "@nestjs/platform-express": "^8.0.6",
    "@nestjs/schedule": "^1.0.2",
    "@nestjs/terminus": "^8.0.3",
    "@nestjs/typeorm": "8.0.2",
    "body-parser": "^1.19.2",
    "class-transformer": "^0.2.3",
    "class-validator": "^0.9.1",
    "lodash": "~4.17.11",
    "morgan": "^1.10.0",
    "nest-winston": "^1.5.0",
    "passport": "^0.4.0",
    "passport-jwt": "^4.0.0",
    "pg": "^7.10.0",
    "reflect-metadata": "~0.1.12",
    "rimraf": "~2.6.2",
    "rxjs": "^7.2.0",
    "typeorm": "0.2.37",
    "uuid": "^7.0.2",
    "winston": "^3.3.3"
  },
  "devDependencies": {
    "@nestjs/testing": "^8.0.6",
    "@types/express": "~4.16.0",
    "@types/jest": "^27.0.1",
    "@types/lodash": "~4.14.118",
    "@types/morgan": "^1.9.4",
    "@types/node": "~16.18.0",
    "@types/passport-jwt": "^3.0.8",
    "@types/supertest": "~2.0.5",
    "@types/uuid": "^8.3.1",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^8.8.0",
    "fishery": "^1.4.0",
    "jest": "^27.0.6",
    "pre-commit": "^1.2.2",
    "prettier": "^2.8.8",
    "supertest": "~4.0.2",
    "ts-jest": "~27.0.5",
    "ts-node": "~10.9.1",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "~3.8.0",
    "typescript": "~4.9.5"
  },
  "jest": {
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": "src",
    "testRegex": ".spec.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
