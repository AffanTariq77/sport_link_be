# Local development only. Copy to .env. Values match docker-compose.yml defaults.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sportslink
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/sportslink_test
# Host ports for docker compose, change if 5432 or 6379 is already taken.
DB_PORT=5432
REDIS_PORT=6379
# SMS for OTP. Only "fake" exists until a provider is chosen; it prints codes to the API log and is refused in production.
SMS_PROVIDER=fake
# Development only: fixed OTP instead of a random one. Refused in production.
# DEV_OTP_CODE=123456
# Master key for CNIC and B-Form data, base64 32 bytes: openssl rand -base64 32. Secrets manager in deployed environments.
DOCUMENT_KEY=
# Document storage. Only "local" (a folder, development only) until S3 is added.
STORAGE_DRIVER=local
STORAGE_DIR=.storage
# Development only: local admin account created by the seed, and a fixed admin two-factor code.
# DEV_ADMIN_EMAIL=admin@sportslink.test
# DEV_ADMIN_PASSWORD=
# DEV_TOTP_CODE=123456
# Push notifications. "log" prints them to the API log (development only, refused in production). "expo" sends through
# the Expo push service; EXPO_ACCESS_TOKEN is only needed if enhanced push security is on in the Expo project.
PUSH_PROVIDER=log
# EXPO_ACCESS_TOKEN=
