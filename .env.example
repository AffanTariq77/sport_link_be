# Local development only. Copy to .env. Values match docker-compose.yml defaults.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sportslink
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/sportslink_test
# Host ports for docker compose, change if 5432 or 6379 is already taken.
DB_PORT=5432
REDIS_PORT=6379
# SMS for OTP. Only "fake" exists until a provider is chosen; it prints codes to the API log and is refused in production.
SMS_PROVIDER=fake
# Development only: fixed OTP instead of a random one. Refused in production.
# DEV_OTP_CODE=123456
